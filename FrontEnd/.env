# AI Narrative Nexus configuration
# Replace placeholder values before deploying to shared environments.

NARRATIVENEXUS_JWT_SECRET=change-this-secret
NARRATIVENEXUS_JWT_EXPIRE_MINUTES=120
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=narrative_nexus
NARRATIVENEXUS_TEST_MODE=0

# NLP pipeline defaults
PREPROCESS_METHOD=porter

# Frontend → backend connectivity
VITE_API_BASE_URL=http://127.0.0.1:8000/api